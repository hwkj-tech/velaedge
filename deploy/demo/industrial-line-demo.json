{
  "project": {
    "projectId": "industrial-demo-lab",
    "name": "工业协议实时演示实验室",
    "environment": "local",
    "owner": "velaedge-demo",
    "description": "连接真实容器化 Modbus TCP、Siemens S7 与 Omron FINS 设备的综合演示项目。"
  },
  "pointSets": [
    {
      "pointSetId": "demo-modbus-pump-points",
      "projectId": "industrial-demo-lab",
      "name": "Modbus 泵站点位集",
      "description": "动态压力、流量、温度、运行和告警点位，运行线圈支持指令写入。",
      "protocol": "ModbusTcp",
      "points": [
        {"pointId":"modbus_pressure","semanticId":"pump.pressure","address":{"kind":"holding_register","value":"40011"},"valueType":"Float","access":"read_only","unit":"MPa","intervalMs":1000},
        {"pointId":"modbus_flow","semanticId":"pump.flow","address":{"kind":"holding_register","value":"40013"},"valueType":"Float","access":"read_only","unit":"m3/h","intervalMs":1000},
        {"pointId":"modbus_temperature","semanticId":"pump.temperature","address":{"kind":"input_register","value":"30001"},"valueType":"Integer","access":"read_only","unit":"C","intervalMs":1000},
        {"pointId":"modbus_running","semanticId":"pump.running","address":{"kind":"coil","value":"00001"},"valueType":"Boolean","access":"read_write","unit":null,"intervalMs":500},
        {"pointId":"modbus_alarm","semanticId":"pump.alarm","address":{"kind":"coil","value":"00007"},"valueType":"Boolean","access":"read_only","unit":null,"intervalMs":500}
      ]
    },
    {
      "pointSetId": "demo-s7-drive-points",
      "projectId": "industrial-demo-lab",
      "name": "Siemens S7 驱动点位集",
      "description": "S7 DB 区压力、速度和状态点位，包含可写启停命令。",
      "protocol": "SiemensS7",
      "points": [
        {"pointId":"s7_pressure","semanticId":"drive.pressure","address":{"kind":"s7_address","value":"DB1.REAL0"},"valueType":"Float","access":"read_only","unit":"bar","intervalMs":500},
        {"pointId":"s7_running","semanticId":"drive.running","address":{"kind":"s7_address","value":"DB1.DBX4.0"},"valueType":"Boolean","access":"read_only","unit":null,"intervalMs":500},
        {"pointId":"s7_speed","semanticId":"drive.speed","address":{"kind":"s7_address","value":"DB1.DINT6"},"valueType":"Integer","access":"read_only","unit":"rpm","intervalMs":500},
        {"pointId":"s7_start_command","semanticId":"drive.command.start","address":{"kind":"s7_address","value":"DB1.DBX10.0"},"valueType":"Boolean","access":"read_write","unit":null,"intervalMs":500}
      ]
    },
    {
      "pointSetId": "demo-fins-machine-points",
      "projectId": "industrial-demo-lab",
      "name": "Omron FINS 机台点位集",
      "description": "FINS 数据存储区计数、温度和状态点位，包含可写启停命令。",
      "protocol": "OmronFins",
      "points": [
        {"pointId":"fins_counter","semanticId":"machine.counter","address":{"kind":"fins_address","value":"D100"},"valueType":"Integer","access":"read_only","unit":"count","intervalMs":1000},
        {"pointId":"fins_temperature","semanticId":"machine.temperature","address":{"kind":"fins_address","value":"D102"},"valueType":"Float","access":"read_only","unit":"C","intervalMs":1000},
        {"pointId":"fins_running","semanticId":"machine.running","address":{"kind":"fins_address","value":"CIO0.0"},"valueType":"Boolean","access":"read_only","unit":null,"intervalMs":500},
        {"pointId":"fins_start_command","semanticId":"machine.command.start","address":{"kind":"fins_address","value":"CIO0.1"},"valueType":"Boolean","access":"read_write","unit":null,"intervalMs":500}
      ]
    }
  ],
  "product": {
    "productId": "industrial-line-demo",
    "projectId": "industrial-demo-lab",
    "name": "工业产线综合采集 Demo",
