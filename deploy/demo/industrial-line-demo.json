      {"task_id":"demo-s7-scan","device_id":"drive-s7-1","point_ids":["s7_pressure","s7_running","s7_speed","s7_start_command"],"interval_ms":500,"enabled":true},
      {"task_id":"demo-fins-scan","device_id":"machine-fins-1","point_ids":["fins_counter","fins_temperature","fins_running","fins_start_command"],"interval_ms":1000,"enabled":true}
    ],
    "algorithms": [
      {
        "id":"modbus-pressure-window","version":"1.0.0","kind":"WindowAggregate","runtime":"Rule",
        "inputs":["modbus_pressure"],"outputs":["modbus_pressure_avg","modbus_pressure_min","modbus_pressure_max","modbus_pressure_count"],
        "dsl":{"inputs":[{"alias":"pressure","pointId":"modbus_pressure"}],"trigger":{"type":"window","everyMs":5000},"steps":[{"type":"windowAggregate","source":"pressure","functions":[{"function":"avg","output":"avg"},{"function":"min","output":"min"},{"function":"max","output":"max"},{"function":"count","output":"count"}]}],"outputs":[{"name":"avg","pointId":"modbus_pressure_avg"},{"name":"min","pointId":"modbus_pressure_min"},{"name":"max","pointId":"modbus_pressure_max"},{"name":"count","pointId":"modbus_pressure_count"}],"report":{"mode":"WindowResult","sink":"velamq-main"}}
      },
      {
        "id":"modbus-running-change","version":"1.0.0","kind":"ChangeReport","runtime":"Rule",
        "inputs":["modbus_running"],"outputs":["modbus_running_changed"],
        "dsl":{"inputs":[{"alias":"running","pointId":"modbus_running"}],"trigger":{"type":"onSample"},"steps":[{"type":"changeFilter","source":"running","threshold":0}],"outputs":[{"name":"value","pointId":"modbus_running_changed"}],"report":{"mode":"OnChange","sink":"velamq-main"}}
      },
      {
        "id":"s7-speed-window","version":"1.0.0","kind":"WindowAggregate","runtime":"Rule",
        "inputs":["s7_speed"],"outputs":["s7_speed_avg","s7_speed_min","s7_speed_max","s7_speed_count"],
        "dsl":{"inputs":[{"alias":"speed","pointId":"s7_speed"}],"trigger":{"type":"window","everyMs":5000},"steps":[{"type":"windowAggregate","source":"speed","functions":[{"function":"avg","output":"avg"},{"function":"min","output":"min"},{"function":"max","output":"max"},{"function":"count","output":"count"}]}],"outputs":[{"name":"avg","pointId":"s7_speed_avg"},{"name":"min","pointId":"s7_speed_min"},{"name":"max","pointId":"s7_speed_max"},{"name":"count","pointId":"s7_speed_count"}],"report":{"mode":"WindowResult","sink":"velamq-main"}}
      },
      {
        "id":"fins-running-change","version":"1.0.0","kind":"ChangeReport","runtime":"Rule",
        "inputs":["fins_running"],"outputs":["fins_running_changed"],
        "dsl":{"inputs":[{"alias":"running","pointId":"fins_running"}],"trigger":{"type":"onSample"},"steps":[{"type":"changeFilter","source":"running","threshold":0}],"outputs":[{"name":"value","pointId":"fins_running_changed"}],"report":{"mode":"OnChange","sink":"velamq-main"}}
      }
    ],
