      {"connection_id":"demo-omron-fins","protocol":"OmronFins","endpoint":"fins://127.0.0.1:19600","omron_fins":{"transport":"tcp","sourceNetwork":0,"sourceNode":0,"sourceUnit":0,"destinationNetwork":0,"destinationNode":0,"destinationUnit":0,"timeoutMs":2000,"wordOrder":"low_word_first"}}
