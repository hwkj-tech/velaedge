# Copy this file outside the repository, restrict it to the field operator, and
# replace every CHANGE_ME value before sourcing it. Never commit the populated file.

# Released package and the production Cloud catalog snapshot source.
EDGEOPS_FIELD_CONFIG=/secure/staging/site-edge-config.json
EDGEOPS_FIELD_CLOUD_DB_SOURCE=/var/lib/edgeops/cloud-agent.sqlite

# Physical southbound interface. Full acceptance rejects PTYs and test devices.
EDGEOPS_FIELD_SERIAL_PORT=/dev/ttyUSB0

# Cloud EdgeLink server identity and Runtime client trust chain.
EDGEOPS_FIELD_SERVER_CERT=/etc/edgeops/tls/current/server.pem
EDGEOPS_FIELD_SERVER_KEY=/etc/edgeops/tls/current/server-key.pem
EDGEOPS_FIELD_RUNTIME_CA=/etc/edgeops/tls/current/runtime-ca.pem
EDGEOPS_FIELD_RUNTIME_CERT=/etc/edgeops/runtime-tls/runtime.pem
EDGEOPS_FIELD_RUNTIME_KEY=/etc/edgeops/runtime-tls/runtime-key.pem
EDGEOPS_FIELD_SERVER_CA=/etc/edgeops/runtime-tls/server-ca.pem
EDGEOPS_FIELD_SERVER_NAME=cloud.example.internal

# Work-order attribution and the exact connected asset identity.
EDGEOPS_FIELD_SITE_ID=CHANGE_ME_WORK_ORDER_ID
EDGEOPS_FIELD_OPERATOR=CHANGE_ME_OPERATOR
EDGEOPS_FIELD_DEVICE_MODEL=CHANGE_ME_DEVICE_MODEL
EDGEOPS_FIELD_DEVICE_SERIAL=CHANGE_ME_DEVICE_SERIAL

# Broker-side consumer/audit receipt. Runtime PUBACK evidence alone is insufficient.
EDGEOPS_FIELD_BROKER_RECEIPT=/secure/staging/velamq-consumer-receipt.json
EDGEOPS_MQTT_PASSWORD=CHANGE_ME_FROM_SECRET_STORE

# Isolated acceptance listeners and retained evidence directory.
EDGEOPS_FIELD_HTTP_PORT=18241
EDGEOPS_FIELD_GATEWAY_PORT=19241
EDGEOPS_FIELD_WORK_DIR=/secure/evidence/velaedge-field-acceptance
EDGEOPS_FIELD_MIN_MQTT_ROUTES=1

# Start with preflight. Set both values below to 0/1 respectively only after the
# wiring, device identity, operating state, and work-order authorization are confirmed.
EDGEOPS_FIELD_PREFLIGHT_ONLY=1
EDGEOPS_FIELD_PHYSICAL_DEVICE_CONFIRMED=0
