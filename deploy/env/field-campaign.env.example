# One environment file represents one physical asset campaign. Install as
# /etc/edgeops/field-campaign/<campaign-id>.env with mode 0600.

EDGEOPS_FIELD_CAMPAIGN_CONFIG=/var/lib/edgeops-field-campaign/CHANGE_ME/input/configuration-package.json
EDGEOPS_FIELD_CAMPAIGN_OUTPUT_DIR=/var/lib/edgeops-field-campaign/CHANGE_ME/evidence-CHANGE_ME_RUN_ID
EDGEOPS_FIELD_CAMPAIGN_NATIVE_BROKER_AUDIT=/var/lib/edgeops-field-campaign/CHANGE_ME/inbox/native-broker-audit.json

# Work-order attribution and the exact physical asset bound to a connection in
# the released package. The runner refuses to start until confirmation is 1.
EDGEOPS_FIELD_CAMPAIGN_SITE_ID=CHANGE_ME_WORK_ORDER_ID
EDGEOPS_FIELD_CAMPAIGN_OPERATOR=CHANGE_ME_OPERATOR
EDGEOPS_FIELD_CAMPAIGN_DEVICE_CONNECTION_ID=CHANGE_ME_CONNECTION_ID
EDGEOPS_FIELD_CAMPAIGN_DEVICE_MANUFACTURER=CHANGE_ME_MANUFACTURER
EDGEOPS_FIELD_CAMPAIGN_DEVICE_MODEL=CHANGE_ME_MODEL
EDGEOPS_FIELD_CAMPAIGN_DEVICE_SERIAL=CHANGE_ME_SERIAL_OR_ASSET_ID
EDGEOPS_FIELD_CAMPAIGN_PHYSICAL_DEVICE_CONFIRMED=0

# Production defaults are shown explicitly for review.
EDGEOPS_FIELD_CAMPAIGN_DURATION_SECONDS=86400
EDGEOPS_FIELD_CAMPAIGN_SCHEDULER_INTERVAL_MS=100
EDGEOPS_FIELD_CAMPAIGN_MAXIMUM_FAILURE_RATIO=0.01
EDGEOPS_FIELD_CAMPAIGN_MAXIMUM_PROGRESS_GAP_SECONDS=300
EDGEOPS_FIELD_CAMPAIGN_RECEIPT_STARTUP_TIMEOUT_SECONDS=30
EDGEOPS_FIELD_CAMPAIGN_RECEIPT_POST_RUN_GRACE_SECONDS=60
EDGEOPS_FIELD_CAMPAIGN_NATIVE_BROKER_AUDIT_WAIT_SECONDS=300

# Optional comma-separated DEVICE_ID/POINT_ID selectors that must change.
EDGEOPS_FIELD_CAMPAIGN_CHANGING_POINTS=CHANGE_ME_DEVICE/CHANGE_ME_POINT

# Set only when the approved work order includes a controlled outage.
EDGEOPS_FIELD_CAMPAIGN_REQUIRE_RECOVERY=0

# MQTT password variables referenced by the released package belong here. The
# package stores only their names; the campaign manifest never stores values.
VELAEDGE_MQTT_PASSWORD=CHANGE_ME_FROM_SECRET_STORE
