EDGEOPS_CLOUD_DB=sqlite:///var/lib/edgeops/cloud-agent.sqlite?mode=rwc
EDGEOPS_HTTP_ADDR=0.0.0.0:8080
EDGEOPS_GATEWAY_ADDR=0.0.0.0:18080
EDGEOPS_CONSOLE_DIST=/opt/edgeops/console
EDGEOPS_API_AUTH_MODE=required
EDGEOPS_BOOTSTRAP_MODE=empty
EDGEOPS_VIEWER_SUBJECT=operations-observer
EDGEOPS_VIEWER_TOKEN=CHANGE_ME_VIEWER_TOKEN_32_CHARS
EDGEOPS_OPERATOR_SUBJECT=configuration-operator
EDGEOPS_OPERATOR_TOKEN=CHANGE_ME_OPERATOR_TOKEN_32_CHARS
EDGEOPS_ADMIN_SUBJECT=platform-administrator
EDGEOPS_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN_32_CHARS
EDGEOPS_GATEWAY_TLS_CERT=/etc/edgeops/tls/current/server.pem
EDGEOPS_GATEWAY_TLS_KEY=/etc/edgeops/tls/current/server-key.pem
EDGEOPS_GATEWAY_TLS_CLIENT_CA=/etc/edgeops/tls/current/runtime-ca.pem
RUST_LOG=cloud_api=info
