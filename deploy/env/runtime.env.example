EDGEOPS_EDGE_ID=edge-production-001
EDGEOPS_DEVICE_ID=default-device
EDGEOPS_RUNTIME_ID=runtime-production-001
EDGEOPS_GATEWAY_ADDR=cloud.example.internal:18080
EDGEOPS_EDGELINK_SERVER_NAME=cloud.example.internal
EDGEOPS_EDGELINK_CA=/etc/edgeops/runtime-tls/ca.pem
