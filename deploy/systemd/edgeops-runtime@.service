[Unit]
Description=VelaEdge Runtime (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgeops-runtime
Group=edgeops-runtime
WorkingDirectory=/var/lib/edgeops-runtime/%i
EnvironmentFile=-/etc/edgeops/runtime/%i.env
ExecStartPre=/opt/edgeops/bin/edge-runtime --config /etc/edgeops/runtime/%i.toml --check-config
ExecStart=/opt/edgeops/bin/edge-runtime --config /etc/edgeops/runtime/%i.toml
Restart=always
RestartSec=3s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/edgeops-runtime/%i
UMask=0077

[Install]
WantedBy=multi-user.target
